    {"id": "diesel", "type": "reserve_loss", "agent": "hospital_1", "fraction": 0.5, "label": "City General diesel flooded: −50% reserve"},
    {"id": "core", "type": "reserve_loss", "agent": "telecom_1", "fraction": 0.7, "label": "Core Exchange batteries fail: −70% reserve"}
